---
source: tests/central.rs
expression: bodies(&server).await.remove(0)
---
{
  "operationName": "TeamsQuery",
  "query": "query TeamsQuery($filter: TeamFilter!, $first: Int, $after: String, $last: Int, $before: String) {\n  teams(filter: $filter, first: $first, after: $after, last: $last, before: $before) {\n    edges {\n      node {\n        id\n        name\n        nameShortened\n        logoUrl\n        colorPrimary\n        colorSecondary\n        private\n        title {\n          id\n          name\n          nameShortened\n          private\n        }\n        organization {\n          id\n          name\n        }\n        assets {\n          assetType\n          url\n        }\n        externalLinks {\n          dataProvider {\n            name\n            description\n          }\n          externalEntity {\n            id\n          }\n        }\n        workflowStatus\n        updatedAt\n      }\n    }\n    pageInfo {\n      hasNextPage\n      hasPreviousPage\n      startCursor\n      endCursor\n    }\n    totalCount\n  }\n}\n",
  "variables": {
    "filter": {
      "titleId": "3"
    },
    "first": 50
  }
}
