---
source: tests/central.rs
expression: body
---
{
  "operationName": "AllSeriesQuery",
  "query": "query AllSeriesQuery($filter: SeriesFilter!, $orderBy: SeriesOrderBy!, $orderDirection: OrderDirection!, $first: Int, $after: String, $last: Int, $before: String) {\n  allSeries(filter: $filter, orderBy: $orderBy, orderDirection: $orderDirection, first: $first, after: $after, last: $last, before: $before) {\n    edges {\n      node {\n        id\n        type\n        startTimeScheduled\n        format {\n          id\n          name\n          nameShortened\n        }\n        title {\n          id\n          name\n          nameShortened\n          private\n        }\n        tournament {\n          id\n          name\n          nameShortened\n        }\n        teams {\n          baseInfo {\n            id\n            name\n            nameShortened\n            logoUrl\n          }\n          scoreAdvantage\n        }\n        players {\n          id\n          nickname\n        }\n        streams {\n          url\n        }\n        productServiceLevels {\n          productName\n          serviceLevel\n        }\n        private\n        externalLinks {\n          dataProvider {\n            name\n            description\n          }\n          externalEntity {\n            id\n          }\n        }\n        workflowStatus\n        updatedAt\n      }\n    }\n    pageInfo {\n      hasNextPage\n      hasPreviousPage\n      startCursor\n      endCursor\n    }\n    totalCount\n  }\n}\n",
  "variables": {
    "filter": {
      "startTimeScheduled": {
        "gte": "2024-01-01T00:00:00Z"
      },
      "titleIds": {
        "in": [
          "3",
          "6"
        ]
      },
      "types": [
        "ESPORTS"
      ]
    },
    "first": 10,
    "orderBy": "StartTimeScheduled",
    "orderDirection": "DESC"
  }
}
