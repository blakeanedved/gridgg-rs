              totalMoneyEarned @include(if: $v3_2)
              moneyPerMinute @include(if: $v3_36)
              moneyPercentage @include(if: $v3_37)
              damageDealt @include(if: $v3_23)
              damageTaken @include(if: $v3_23)
              damagePerMinute @include(if: $v3_24)
              damagePercentage @include(if: $v3_25)
              damagePerMoney @include(if: $v3_26)
              kdaRatio @include(if: $v3_27)
              killsAndAssists @include(if: $v3_34)
              killParticipation @include(if: $v3_35)
              visionScore @include(if: $v3_30)
              visionScorePerMinute @include(if: $v3_33)
              forwardPercentage @include(if: $v3_42)
            }
            ... on GamePlayerStateValorant {
              alive @include(if: $v1_9)
              currentHealth @include(if: $v1_9)
              maxHealth @include(if: $v1_9)
              currentArmor @include(if: $v1_9)
              ultimatePoints @include(if: $v3_20)
              headshots
              teamHeadshots
              damageDealt @include(if: $v3_29)
              damageTaken @include(if: $v3_29)
              selfdamageDealt @include(if: $v3_29)
              selfdamageTaken @include(if: $v3_29)
              teamdamageDealt @include(if: $v3_29)
              teamdamageTaken @include(if: $v3_29)
            }
          }
        }
        __typename
        ... {
          __typename
          ... on GameTeamStateLol {
            experiencePoints
            totalMoneyEarned @include(if: $v3_2)
            moneyDifference @include(if: $v3_28)
            moneyPerMinute @include(if: $v3_36)
            majorMoneyLead @include(if: $v3_40)
            majorMoneyDeficit @include(if: $v3_41)
            damageDealt @include(if: $v3_23)
            damageTaken @include(if: $v3_23)
            damagePerMinute @include(if: $v3_24)
            damagePerMoney @include(if: $v3_26)
            kdaRatio @include(if: $v3_27)
            killsAndAssists @include(if: $v3_34)
            visionScore @include(if: $v3_30)
            visionScorePerMinute @include(if: $v3_33)
            forwardPercentage @include(if: $v3_42)
            baronPowerPlays @include(if: $v3_38) {
              id
              value
            }
          }
          ... on GameTeamStateValorant {
            headshots
            teamHeadshots
            damageDealt @include(if: $v3_29)
            damageTaken @include(if: $v3_29)
            selfdamageDealt @include(if: $v3_29)
            selfdamageTaken @include(if: $v3_29)
            teamdamageDealt @include(if: $v3_29)
            teamdamageTaken @include(if: $v3_29)
          }
        }
      }
      segments @include(if: $v1_4) {
        id
