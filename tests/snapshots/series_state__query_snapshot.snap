              name
              quantity
              equipped
              stashed
            }
          }
          objectives {
            id
            type
            completionCount
            completedFirst @include(if: $v3_11)
          }
          __typename
          ... {
            __typename
            ... on GamePlayerStateLol {
              alive
              currentHealth
              maxHealth
              currentArmor
              experiencePoints
              respawnClock @include(if: $v3_3) {
                id
                type
                ticking
                ticksBackwards
                currentSeconds
