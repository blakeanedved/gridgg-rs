          avg
        }
      }
      structuresCaptured {
        sum
        min
        max
        avg
        ratePerMinute {
          min
          max
          avg
        }
      }
      firstKill {
        value
        count
        percentage
        streak {
          current
          max
          min
        }
      }
      objectives {
