query PlayerStatisticsQuery($playerId: ID!, $filter: PlayerStatisticsFilter!) {
  playerStatistics(playerId: $playerId, filter: $filter) {
    id
    aggregationSeriesIds
    series {
      count
      won {
        value
        count
        percentage
        streak {
          current
          max
          min
        }
      }
      kills {
        sum
        min
        max
        avg
        ratePerMinute {
          min
          max
          avg
        }
      }
      deaths {
        sum
        min
        max
        avg
        ratePerMinute {
          min
          max
          avg
        }
      }
      killAssistsGiven {
        sum
        min
        max
        avg
        ratePerMinute {
          min
          max
          avg
        }
      }
      killAssistsReceived {
        sum
        min
        max
        avg
        ratePerMinute {
          min
          max
          avg
        }
      }
      selfkills {
        sum
        min
        max
        avg
        ratePerMinute {
          min
          max
          avg
        }
      }
      teamkills {
        sum
        min
        max
        avg
        ratePerMinute {
          min
          max
          avg
        }
      }
      teamkillAssistsGiven {
        sum
        min
        max
        avg
        ratePerMinute {
          min
          max
          avg
        }
      }
      teamkillAssistsReceived {
        sum
        min
        max
        avg
        ratePerMinute {
          min
          max
          avg
        }
      }
      structuresDestroyed {
        sum
        min
        max
        avg
        ratePerMinute {
          min
          max
          avg
        }
      }
      structuresCaptured {
        sum
        min
        max
        avg
        ratePerMinute {
          min
          max
          avg
        }
      }
      firstKill {
        value
        count
        percentage
        streak {
          current
          max
          min
        }
      }
      objectives {
        type
        completionCount {
          sum
          min
          max
          avg
          ratePerMinute {
            min
            max
            avg
          }
        }
        completedFirst {
          value
          count
          percentage
          streak {
            current
            max
            min
          }
        }
      }
      __typename
      ... {
        __typename
        ... on ValorantPlayerSeriesStatistics {
          headshots {
            sum
            min
            max
            avg
            ratePerMinute {
              min
              max
              avg
            }
          }
        }
      }
    }
    game {
      count
      won {
        value
        count
        percentage
        streak {
          current
          max
          min
        }
      }
      kills {
        sum
        min
        max
        avg
        ratePerMinute {
          min
          max
          avg
        }
      }
      deaths {
        sum
        min
        max
        avg
        ratePerMinute {
