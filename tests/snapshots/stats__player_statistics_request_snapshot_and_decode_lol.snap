          sum
          min
          max
          avg
          ratePerMinute {
            min
            max
            avg
          }
        }
      }
      __typename
      ... {
        __typename
        ... on PlayerGameStatisticsLol {
          damageDealt {
            sum
            min
            max
            avg
            ratePerMinute {
