---
source: tests/stats.rs
expression: request_snapshot(&body)
---
query SeriesStatisticsQuery($titleId: ID!, $filter: SeriesStatisticsFilter!) {
  seriesStatistics(titleId: $titleId, filter: $filter) {
    aggregationSeriesIds
    count
    series {
      draftActions {
        draftable {
          id
          name
          type
        }
        type {
          value
          count
          percentage
        }
      }
    }
    games {
      count {
        sum
        min
        max
        avg
        ratePerMinute {
          min
          max
          avg
        }
      }
      duration {
        sum
        min
        max
        avg
      }
      map {
        map {
          id
          name
        }
        count
        percentage
      }
      draftActions {
        draftable {
          id
          name
          type
        }
        type {
          value
          count
          percentage
        }
      }
      teams {
        count
        won {
          value
          count
          percentage
          streak {
            current
            max
            min
          }
        }
        score {
          sum
          min
          max
          avg
          ratePerMinute {
            min
            max
            avg
          }
        }
        duration {
          sum
          min
          max
          avg
        }
        kills {
          sum
          min
          max
          avg
          ratePerMinute {
            min
            max
            avg
          }
        }
        deaths {
          sum
          min
          max
          avg
          ratePerMinute {
            min
            max
            avg
          }
        }
        killAssistsGiven {
          sum
          min
          max
          avg
          ratePerMinute {
            min
            max
            avg
          }
        }
        killAssistsReceived {
          sum
          min
          max
          avg
          ratePerMinute {
            min
            max
            avg
          }
        }
        selfkills {
          sum
          min
          max
          avg
          ratePerMinute {
            min
            max
            avg
          }
        }
        teamkills {
          sum
          min
          max
          avg
          ratePerMinute {
            min
            max
            avg
          }
        }
        teamkillAssistsGiven {
          sum
          min
          max
          avg
          ratePerMinute {
            min
            max
            avg
          }
        }
        teamkillAssistsReceived {
          sum
          min
          max
          avg
          ratePerMinute {
            min
            max
            avg
          }
        }
        structuresDestroyed {
          sum
          min
          max
          avg
          ratePerMinute {
            min
            max
            avg
          }
        }
        structuresCaptured {
          sum
          min
          max
          avg
          ratePerMinute {
            min
            max
            avg
          }
        }
        firstKill {
          value
          count
          percentage
          streak {
            current
            max
            min
          }
        }
        objectives {
          type
          completionCount {
            sum
            min
            max
            avg
            ratePerMinute {
              min
              max
              avg
            }
          }
          completedFirst {
            value
            count
            percentage
            streak {
              current
              max
              min
            }
          }
        }
        money {
          sum
          min
          max
          avg
          ratePerMinute {
            min
            max
            avg
          }
        }
        inventoryValue {
          sum
          min
          max
          avg
          ratePerMinute {
            min
            max
            avg
          }
        }
        netWorth {
          sum
          min
          max
          avg
          ratePerMinute {
            min
            max
            avg
          }
        }
        unitKills {
          unitName
          count {
            sum
            min
            max
            avg
            ratePerMinute {
              min
              max
              avg
            }
          }
        }
      }
    }
    segments {
      type
      count {
        sum
        min
        max
        avg
        ratePerMinute {
          min
          max
          avg
        }
      }
    }
  }
}

variables: {
  "filter": {
    "startedAt": {
      "period": "LAST_WEEK"
    },
    "tournament": {
      "id": {
        "in": [
          "7"
        ]
      }
    }
  },
  "titleId": "6"
}
