{
  "operationName": "PlayersQuery",
  "query": "query PlayersQuery($filter: PlayerFilter!, $first: Int, $after: String, $last: Int, $before: String) {\n  players(filter: $filter, first: $first, after: $after, last: $last, before: $before) {\n    edges {\n      node {\n        id\n        nickname\n        roles {\n          id\n          name\n          private\n          title {\n            id\n            name\n            nameShortened\n            private\n          }\n        }\n        private\n        title {\n          id\n          name\n          nameShortened\n          private\n        }\n        team {\n          id\n          name\n          nameShortened\n          logoUrl\n        }\n        externalLinks {\n          dataProvider {\n            name\n            description\n          }\n          externalEntity {\n            id\n          }\n        }\n        updatedAt\n      }\n    }\n    pageInfo {\n      hasNextPage\n      hasPreviousPage\n      startCursor\n      endCursor\n    }\n    totalCount\n  }\n}\n",
  "variables": {
    "before": "z",
    "filter": {
      "nickname": {
        "contains": "caps"
      },
      "teamIdFilter": {
        "id": null
      }
    },
    "last": 5
  }
}
